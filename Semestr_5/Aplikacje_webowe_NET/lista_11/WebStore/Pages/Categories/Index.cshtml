@page
@model WebStore.Pages.Categories.IndexModel
@{ ViewData["Title"] = "Kategorie"; }

<h1>Kategorie</h1>
<p><a asp-page="Create" class="btn btn-primary">Dodaj nową</a></p>
<table class="table">
    <thead>
        <tr>
            <th>Nazwa</th>
            <th>Akcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Categories) {
            <tr>
                <td>@item.Name</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edytuj</a>
                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Usuń</a>
                </td>
            </tr>
        }
    </tbody>
</table>