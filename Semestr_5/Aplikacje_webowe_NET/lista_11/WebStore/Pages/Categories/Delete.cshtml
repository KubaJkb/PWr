@page "{id:int}"
@model WebStore.Pages.Categories.DeleteModel
@{ ViewData["Title"] = "Usuń kategorię"; }

<h1>Usuń kategorię</h1>
<h3>Czy na pewno chcesz usunąć kategorię "@Model.Category.Name"?</h3>
<div class="alert alert-danger">
    Uwaga: Usunięcie kategorii spowoduje usunięcie wszystkich przypisanych do niej towarów!
</div>
<div>
    <form method="post">
        <input type="hidden" asp-for="Category.Id" />
        <input type="submit" value="Usuń" class="btn btn-danger" />
        <a asp-page="./Index" class="btn btn-secondary">Anuluj</a>
    </form>
</div>