@page "{id:int}"
@model WebStore.Pages.Articles.DeleteModel
@{ ViewData["Title"] = "Usuń"; }

<h1>Usuń towar</h1>
<h3>Czy na pewno chcesz usunąć ten towar?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Article.Name)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Article.Name)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Article.Price)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Article.Price)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Article.Category)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Article.Category.Name)</dd>

        <dt class="col-sm-2">Zdjęcie</dt>
        <dd class="col-sm-10">
            @if (Model.Article.ImageName != null)
            {
                <img src="~/images/@Model.Article.ImageName" class="img-fluid rounded" style="max-width: 300px;" alt="@Model.Article.Name" />
            }
            else
            {
                <img src="~/images/NoImage.png" class="img-fluid rounded" style="max-width: 300px;" alt="Brak zdjęcia" />
            }
        </dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Article.Id" />
        <input type="submit" value="Usuń" class="btn btn-danger" />
        <a asp-page="./Index" class="btn btn-secondary">Anuluj</a>
    </form>
</div>