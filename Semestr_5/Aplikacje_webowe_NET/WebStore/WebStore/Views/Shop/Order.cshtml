@model WebStore.Models.OrderViewModel
@{ ViewData["Title"] = "Podsumowanie zamówienia"; }

<h2 class="mb-4">Podsumowanie zamówienia</h2>

<div class="row">
    <div class="col-md-7">
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0">Produkty w koszyku</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-borderless mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Produkt</th>
                            <th class="text-center">Ilość</th>
                            <th class="text-end">Wartość</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var item in Model.CartItems)
                        {
                            <tr class="border-bottom">
                                <td>@item.Article.Name</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@item.Value.ToString("N2") zł</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-light">
                        <tr>
                            <td colspan="2" class="text-end fw-bold">Razem:</td>
                            <td class="text-end fw-bold text-success fs-5">@Model.Total.ToString("N2") zł</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Dane do wysyłki</h5>
            </div>
            <div class="card-body">
                <form asp-action="Order" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" placeholder="Jan Kowalski" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label"></label>
                        <textarea asp-for="Address" class="form-control" rows="3" placeholder="ul. Przykładowa 1/2, 00-000 Miasto"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PaymentMethod" class="form-label"></label>
                        <select asp-for="PaymentMethod" class="form-select">
                            <option value="">-- Wybierz --</option>
                            <option value="Przelew">Tradycyjny przelew</option>
                            <option value="Karta">Karta płatnicza</option>
                            <option value="BLIK">BLIK</option>
                            <option value="Pobranie">Za pobraniem</option>
                        </select>
                        <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-success btn-lg">Potwierdź zamówienie</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}