@model IEnumerable<WebStore.Models.Article>

@{
    ViewData["Title"] = "Sklep";
    var categories = ViewBag.Categories as IEnumerable<WebStore.Models.Category>;
    var currentCategoryId = ViewBag.CurrentCategoryId as int?;
    
    // Konfiguracja początkowa dla JS
    int initialCount = Model.Count();
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-3 mb-4">
            <h4 class="mb-3">Kategorie</h4>
            <div class="list-group">
                <a asp-action="Index" 
                   asp-route-categoryId="" 
                   class="list-group-item list-group-item-action @(currentCategoryId == null ? "active" : "")">
                   Wszystkie
                </a>

                @if (categories != null)
                {
                    foreach (var category in categories)
                    {
                        <a asp-action="Index" 
                           asp-route-categoryId="@category.Id" 
                           class="list-group-item list-group-item-action @(currentCategoryId == category.Id ? "active" : "")">
                            @category.Name
                        </a>
                    }
                }
            </div>
        </div>

        <div class="col-md-9">
            <h2 class="mb-4">
                @(currentCategoryId == null ? "Wszystkie produkty" : "Produkty z wybranej kategorii")
            </h2>

            <div id="articles-container" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var item in Model.Take(12)) 
                {
                    <partial name="_ArticleCard" model="item" />
                }
            </div>
            
            <div id="loading-spinner" class="text-center my-4" style="display: none;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Ładowanie...</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let skip = @initialCount > 12 ? 12 : @initialCount;
        let isLoading = false;
        const categoryId = '@currentCategoryId';
        const batchSize = 9;
        let allLoaded = false;

        window.addEventListener('scroll', () => {
            if (allLoaded || isLoading) return;

            const { scrollTop, scrollHeight, clientHeight } = document.documentElement;

            if (scrollTop + clientHeight >= scrollHeight - 100) {
                loadMoreArticles();
            }
        });

        function loadMoreArticles() {
            isLoading = true;
            document.getElementById('loading-spinner').style.display = 'block';

            let url = `/api/articles?skip=${skip}&take=${batchSize}`;
            if (categoryId) {
                url += `&categoryId=${categoryId}`;
            }

            fetch(url)
                .then(response => response.json())
                .then(data => {
                    if (data.length === 0) {
                        allLoaded = true;
                        document.getElementById('loading-spinner').style.display = 'none';
                        return;
                    }

                    const container = document.getElementById('articles-container');
                    
                    data.forEach(item => {
                        const html = generateArticleCard(item);
                        container.insertAdjacentHTML('beforeend', html);
                    });

                    skip += data.length;
                    isLoading = false;
                    document.getElementById('loading-spinner').style.display = 'none';
                    
                    if(data.length < batchSize) allLoaded = true;
                })
                .catch(error => {
                    console.error('Error:', error);
                    isLoading = false;
                });
        }

        function generateArticleCard(item) {
            const imagePath = item.imageName ? `/images/${item.imageName}` : '/images/NoImage.png';
            const categoryName = item.category ? item.category.name : '';
            const price = item.price.toLocaleString('pl-PL', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            return `
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <a href="/Shop/Details/${item.id}" class="text-decoration-none">
                            <div style="height: 200px; overflow: hidden; display: flex; align-items: center; justify-content: center; background-color: #f8f9fa;">
                                <img src="${imagePath}" class="card-img-top" alt="${item.name}" 
                                     style="width: 100%; height: 100%; object-fit: cover;">
                            </div>
                        </a>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">
                                <a href="/Shop/Details/${item.id}" class="text-decoration-none text-dark stretched-link">
                                    ${item.name}
                                </a>
                            </h5>
                            <p class="card-text text-muted small">${categoryName}</p>
                            <div class="mt-auto d-flex justify-content-between align-items-center gap-2">
                                <span class="h5 mb-0 text-primary">${price} zł</span>
                                <div class="btn-group">
                                    <a href="/Shop/AddToCart/${item.id}" class="btn btn-outline-success btn-sm position-relative" style="z-index: 2;">
                                        🛒 Dodaj
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }
    </script>
}