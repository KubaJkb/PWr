@model WebStore.Models.Article

@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="row g-0">
            <div class="col-md-6 bg-light d-flex align-items-center justify-content-center" style="min-height: 400px;">
                @{
                    string imagePath = Model.ImageName != null
                    ? "/images/" + Model.ImageName
                    : "/images/NoImage.png";
                }
                <img src="@imagePath" class="img-fluid rounded-start" alt="@Model.Name" style="max-height: 400px; object-fit: contain;">
            </div>

            <div class="col-md-6">
                <div class="card-body p-5">
                    <div class="mb-2">
                        <span class="badge bg-secondary">@Model.Category?.Name</span>
                    </div>

                    <h1 class="card-title display-5 fw-bold text-dark">@Model.Name</h1>

                    <h3 class="text-primary my-4">@Model.Price.ToString("N2") PLN</h3>

                    <p class="card-text text-muted">
                        Data ważności: @Model.ExpirationDate.ToShortDateString()
                    </p>

                    <div class="d-grid gap-2 mt-5">
                        <a asp-action="AddToCart" asp-route-id="@Model.Id" class="btn btn-success btn-lg">
                            🛒 Dodaj do koszyka
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Wróć do sklepu
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>