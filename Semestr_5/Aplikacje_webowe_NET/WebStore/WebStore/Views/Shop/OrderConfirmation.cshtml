@model WebStore.Models.OrderViewModel
@{ ViewData["Title"] = "Zamówienie przyjęte"; }

<div class="text-center mt-5">
    <div class="display-1 text-success mb-3">✓</div>
    <h1 class="display-5 fw-bold">Dziękujemy za zamówienie!</h1>
    <p class="lead text-muted">Twoje zamówienie zostało przyjęte do realizacji.</p>
</div>

<div class="row justify-content-center mt-5">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Szczegóły zamówienia</h5>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h6 class="text-muted text-uppercase small">Odbiorca</h6>
                        <p class="fw-bold mb-0">@Model.FullName</p>
                        <p class="mb-0 text-muted" style="white-space: pre-line;">@Model.Address</p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted text-uppercase small">Płatność</h6>
                        <p class="fw-bold">@Model.PaymentMethod</p>
                        <h6 class="text-muted text-uppercase small">Kwota łączna</h6>
                        <p class="fw-bold text-success fs-5">@Model.Total.ToString("N2") zł</p>
                    </div>
                </div>
                
                <div class="text-center">
                    <a asp-action="Index" class="btn btn-primary">Wróć do sklepu</a>
                </div>
            </div>
        </div>
    </div>
</div>