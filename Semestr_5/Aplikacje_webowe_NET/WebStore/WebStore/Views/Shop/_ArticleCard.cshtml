@model WebStore.Models.Article

<div class="col">
    <div class="card h-100 shadow-sm border-0">
        @{
            string imagePath = Model.ImageName != null 
                ? "/images/" + Model.ImageName 
                : "/images/NoImage.png";
        }
        
        <a asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none">
            <div style="height: 200px; overflow: hidden; display: flex; align-items: center; justify-content: center; background-color: #f8f9fa;">
                <img src="@imagePath" class="card-img-top" alt="@Model.Name" 
                     style="width: 100%; height: 100%; object-fit: cover;">
            </div>
        </a>

        <div class="card-body d-flex flex-column">
            <h5 class="card-title">
                <a asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none text-dark stretched-link">
                    @Model.Name
                </a>
            </h5>
            <p class="card-text text-muted small">@Model.Category?.Name</p>

            <div class="mt-auto d-flex justify-content-between align-items-center gap-2">
                <span class="h5 mb-0 text-primary">@Model.Price.ToString("N2") zł</span>

                <div class="btn-group">
                    <a asp-action="AddToCart" asp-route-id="@Model.Id" class="btn btn-outline-success btn-sm position-relative" style="z-index: 2;">
                        🛒 Dodaj
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>