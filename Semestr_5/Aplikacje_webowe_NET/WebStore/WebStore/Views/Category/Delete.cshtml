@model WebStore.Models.Category
@{ ViewData["Title"] = "Usuń kategorię"; }

<h1>Usuń kategorię</h1>
<h3>Czy na pewno chcesz usunąć kategorię "@Model.Name"?</h3>
<div class="alert alert-danger">
    Uwaga: Usunięcie kategorii spowoduje usunięcie wszystkich przypisanych do niej towarów!
</div>
<div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Usuń" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
    </form>
</div>